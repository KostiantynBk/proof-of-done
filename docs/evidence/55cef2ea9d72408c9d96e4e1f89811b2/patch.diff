+from decimal import Decimal
+
+
+def test_audit_record_contains_all_required_fields(context):
+    _, order, _, audit, service = context
+    service.issue(order, "req-1", Decimal("10.00"), "alice", "damaged item")
+    assert len(audit.events) == 1
+    event = audit.events[0]
+    assert event.actor == "alice"
+    assert event.amount == Decimal("10.00")
+    assert event.reason == "damaged item"
+    assert event.order_id == "order-1"
+    assert event.action == "refund_issued"
+
+
+def test_each_issued_refund_creates_one_audit_record(context):
+    _, order, _, audit, service = context
+    service.issue(order, "req-1", Decimal("10.00"), "alice", "return")
+    service.issue(order, "req-2", Decimal("20.00"), "bob", "late delivery")
+    assert len(audit.events) == 2
+    assert audit.events[0].actor == "alice"
+    assert audit.events[1].actor == "bob"
+    assert audit.events[1].amount == Decimal("20.00")
+    assert audit.events[1].reason == "late delivery"
+    assert audit.events[1].order_id == "order-1"
