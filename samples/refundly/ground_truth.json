[
  {
    "key": "REQ-refund-cap",
    "kind": "requirement",
    "anchor": "A refund may never exceed the captured amount minus refunds already issued.",
    "expected_verdict": "PROVEN",
    "why": "The boundary tests protect the remaining capture and equality.",
    "oracle_mutations": [
      {
        "file": "refundly/refunds.py",
        "search": "amount > order.captured - order.refunded",
        "replace": "amount >= order.captured - order.refunded",
        "expect": "killed"
      },
      {
        "file": "refundly/refunds.py",
        "search": "amount > order.captured - order.refunded",
        "replace": "amount > order.captured",
        "expect": "killed"
      }
    ]
  },
  {
    "key": "REQ-manager-approval",
    "kind": "requirement",
    "anchor": "Refunds requested more than 90 days after the order date require manager approval.",
