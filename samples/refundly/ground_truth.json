        "search": "attempts += 1",
        "replace": "attempts += 0",
        "expect": "killed"
      },
      {
        "file": "refundly/refunds.py",
        "search": "if attempts == 3:",
        "replace": "if attempts == 2:",
        "expect": "killed"
      },
      {
        "file": "refundly/refunds.py",
        "search": "while attempts < 3:",
        "replace": "while attempts < 2:",
        "expect": "killed"
      }
    ]
  },
  {
    "key": "REQ-round-down",
    "kind": "requirement",
    "anchor": "Partial refund amounts are rounded down to the cent.",
    "expected_verdict": "PROVEN",
    "why": "The fractional-cent test checks the result, accounting, and gateway amount.",
    "oracle_mutations": [
      {
        "file": "refundly/money.py",
        "search": "value.quantize(CENT, rounding=ROUND_DOWN)",
        "replace": "value.quantize(CENT)",
        "expect": "killed"
      },
      {
        "file": "refundly/money.py",
        "search": "value.quantize(CENT, rounding=ROUND_DOWN)",
        "replace": "value.quantize(Decimal('0.1'), rounding=ROUND_DOWN)",
        "expect": "killed"
      }
    ]
  },
  {
    "key": "RULE-money",
    "kind": "rule",
    "anchor": "Use Decimal and money helpers for amounts, never float.",
    "expected_verdict": "PROVEN",
    "why": "Float inputs are rejected and fractional-cent arithmetic stays exact.",
    "oracle_mutations": [
      {
        "file": "refundly/refunds.py",
        "search": "cents(amount)",
        "replace": "cents(float(amount))",
        "expect": "killed"
      },
      {
        "file": "refundly/refunds.py",
        "search": "cents(amount)",
        "replace": "cents(Decimal(float(amount)))",
        "expect": "killed"
      }
    ]
  },
