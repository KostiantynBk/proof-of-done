  {
    "key": "REQ-gift-credit",
    "kind": "requirement",
    "anchor": "Orders paid by gift card are refunded only as store credit.",
    "expected_verdict": "VIOLATED",
    "why": "The service currently directs gift card refunds back to gift cards.",
    "oracle_mutations": [
      {
        "file": "refundly/refunds.py",
        "search": "destination != order.payment_method",
        "replace": "False",
        "expect": "survived"
      },
      {
        "file": "refundly/refunds.py",
        "search": "destination != order.payment_method",
        "replace": "destination != destination",
        "expect": "survived"
      }
    ],
    "oracle_test": "from decimal import Decimal\nfrom refundly.orders import Order\nfrom refundly.audit import AuditLog\nfrom refundly.gateway import FakeGateway\nfrom refundly.refunds import RefundService\nfrom refundly import clock\n\ndef test_gift_card_refunds_to_store_credit():\n    order = Order(\"gift\", Decimal(\"10\"), \"gift_card\", clock.now())\n    gateway = FakeGateway()\n    result = RefundService(gateway, AuditLog()).issue(order, \"gift-1\", Decimal(\"1\"), \"alice\", \"return\")\n    assert result.method == \"store_credit\"\n    assert gateway.transfers[0][2] == \"store_credit\"\n"
  },
  {
    "key": "REQ-idempotency",
    "kind": "requirement",
    "anchor": "the same request_id processed twice results in exactly one refund.",
    "expected_verdict": "PROVEN",
    "why": "A repeated request is checked for both identity and transfer count.",
    "oracle_mutations": [
      {
        "file": "refundly/refunds.py",
        "search": "request_id in self.processed",
        "replace": "False",
        "expect": "killed"
      },
      {
        "file": "refundly/refunds.py",
        "search": "self.processed[request_id] = result",
        "replace": "pass",
        "expect": "killed"
      }
    ]
  },
  {
